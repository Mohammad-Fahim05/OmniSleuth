# ============================================================
# OmniSleuth Configuration Template
# Copy this file to .env and configure as needed
# ============================================================

# Environment
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/omnisleuth.log

# Investigation Limits (Rule 7: Bounded Agentic Behavior)
MAX_INVESTIGATION_DEPTH=3
MAX_TOOL_CALLS=10
MAX_RETRIES=2

# Storage & Persistence
SQLITE_DB_PATH=data/omnisleuth.db
VECTORSTORE_DIR=data/vectorstore
UPLOADS_DIR=data/uploads

# LLM & Embeddings (for later agent/RAG phases)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
