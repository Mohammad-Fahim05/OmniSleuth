# ============================================================
# OmniSleuth Configuration Template
# Copy this file to .env and configure as needed
# ============================================================

# Environment
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/omnisleuth.log

# Investigation Limits (Rule 7: Bounded Agentic Behavior)
MAX_INVESTIGATION_DEPTH=3
MAX_TOOL_CALLS=10
MAX_RETRIES=2

# Storage & Persistence
SQLITE_DB_PATH=data/omnisleuth.db
VECTORSTORE_DIR=data/vectorstore
UPLOADS_DIR=data/uploads

# LLM & Embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Phase 19 LLM Gateway Settings
LLM_PROVIDER=fallback  # options: 'openai', 'azure', 'fallback'
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=10.0

# Azure OpenAI (Optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Metering & Cache
LLM_INPUT_PRICE_PER_1K=0.00015
LLM_OUTPUT_PRICE_PER_1K=0.00060
LLM_CACHE_ENABLED=false
LLM_CACHE_SIMILARITY_THRESHOLD=0.95
